<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ingreso - Simpsons Trivia</title>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --simpson-yellow: #FED90F;
            --simpson-blue: #3F90D7;
            --simpson-red: #DB5349;
            --simpson-green: #7BC043;
        }
        
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #f8f9fa;
            margin: 0;
            padding: 0;
            color: #333;
        }
        
        .header {
            background-color: var(--simpson-yellow);
            padding: 15px;
            text-align: center;
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        
        h1, h2 {
            font-family: 'Bangers', cursive;
            color: #333;
        }
        
        h1 {
            font-size: 2.5em;
            margin: 0;
            text-shadow: 2px 2px 0 #fff;
        }
        
        .container {
            max-width: 900px;
            margin: 30px auto;
            padding: 0 20px;
        }
        
        .form-wrapper {
            display: flex;
            justify-content: center;
            gap: 30px;
            flex-wrap: wrap;
        }
        
        .form-container {
            background-color: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 6px 15px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 350px;
            transition: transform 0.3s;
        }
        
        .form-container:hover {
            transform: translateY(-5px);
        }
        
        .form-container h2 {
            text-align: center;
            font-size: 1.8em;
            margin-top: 0;
            color: #333;
        }
        
        .form-group {
            margin-bottom: 20px;
        }
        
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: bold;
            color: #555;
        }
        
        input {
            width: 100%;
            padding: 12px;
            border: 2px solid #ddd;
            border-radius: 8px;
            font-size: 1em;
            transition: border-color 0.3s;
            box-sizing: border-box;
        }
        
        input:focus {
            border-color: var(--simpson-blue);
            outline: none;
        }
        
        button {
            width: 100%;
            padding: 14px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 1em;
            cursor: pointer;
            transition: background-color 0.2s, transform 0.2s;
            text-transform: uppercase;
        }
        
        button:hover {
            transform: translateY(-2px);
        }
        
        button:active {
            transform: translateY(1px);
        }
        
        .primary-button {
            background-color: var(--simpson-blue);
            color: white;
        }
        
        .oauth-button {
            background-color: #333;
            color: white;
            margin-top: 15px;
        }
        
        .oauth-button.google {
            background-color: #4285F4;
        }
        
        .back-button {
            background-color: var(--simpson-green);
            color: white;
            width: auto;
            display: inline-block;
            margin: 20px 0;
        }
        
        #mensaje {
            text-align: center;
            padding: 10px;
            margin: 20px 0;
            border-radius: 8px;
            font-weight: bold;
        }
        
        @media (max-width: 768px) {
            .form-container {
                max-width: 100%;
            }
        }
    </style>
</head>
<body>
    <% if (process.env.NODE_ENV !== 'production') { %>
    <div class="header">
        <h1>Simpsons Trivia</h1>
    </div>
    
    <div class="container">
        <div style="text-align: center;">
            <button class="back-button" onclick="window.location.href='/'">← Volver al inicio</button>
        </div>
        
        <div class="form-wrapper">
            <div class="form-container">
                <h2>Iniciar Sesión</h2>
                <form onsubmit="return validarLogin()">
                    <div class="form-group">
                        <label for="login-email">Email:</label>
                        <input type="email" id="login-email" name="email" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="login-password">Contraseña:</label>
                        <input type="password" id="login-password" name="password" required>
                    </div>
                    
                    <button type="submit" class="primary-button">Ingresar</button>
                </form>
                <button class="oauth-button" onclick="loginWithProvider('github')">Ingresar con GitHub</button>
                <button class="oauth-button google" onclick="loginWithProvider('google')">Ingresar con Google</button>
            </div>
            
            <div class="form-container">
                <h2>Registrarse</h2>
                <form onsubmit="return validarRegistro()">
                    <div class="form-group">
                        <label for="reg-username">Nombre de usuario:</label>
                        <input type="text" id="reg-username" name="username" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="reg-email">Email:</label>
                        <input type="email" id="reg-email" name="email" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="reg-password">Contraseña:</label>
                        <input type="password" id="reg-password" name="password" required>
                    </div>
                    
                    <div class="form-group">
                        <label for="confirm-password">Confirmar Contraseña:</label>
                        <input type="password" id="confirm-password" name="confirmPassword" required>
                    </div>
                    
                    <button type="submit" class="primary-button">Registrarse</button>
                </form>
            </div>
        </div>
        
        <div id="mensaje" style="display: none;">
            <% if(typeof errorMessage !== 'undefined') { %>
                <%= errorMessage %>
            <% } %>
        </div>
    </div>
    <% } %>
    
    <script>
        function mostrarMensaje(mensaje, esError) {
            const mensajeElement = document.getElementById('mensaje');
            mensajeElement.textContent = mensaje;
            mensajeElement.style.display = 'block';
            mensajeElement.style.backgroundColor = esError ? '#f8d7da' : '#d4edda';
            mensajeElement.style.color = esError ? '#721c24' : '#155724';
        }
        
        async function realizarSolicitudPost(url, datos) {
            try {
                const respuesta = await fetch(url, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(datos)
                });
                const resultado = await respuesta.json();

                if (respuesta.ok) {
                    mostrarMensaje(resultado.message || 'Operación exitosa', false);
                    if (resultado.success) {
                        if (url === '/api/v1/login') {
                            mostrarMensaje('Sesión iniciada, ingresando...', false);
                            setTimeout(() => {
                                window.location.href = '/api/v1/profile';
                            }, 1500);
                        } else {
                            window.location.href = '/api/v1/profile';
                        }
                    }
                } else {
                    mostrarMensaje(resultado.error || 'Error en la operación', true);
                }
            } catch (error) {
                mostrarMensaje('Error en la solicitud', true);
            }
        }

        function validarRegistro() {
            const username = document.getElementById("reg-username").value;
            const email = document.getElementById("reg-email").value;
            const password = document.getElementById("reg-password").value;
            const confirmPassword = document.getElementById("confirm-password").value;
            let mensajesError = [];

            if (username.length < 3) {
                mensajesError.push("El nombre de usuario debe tener al menos 3 caracteres");
            }
            if (!email.match(/^[^@]+@[^@]+\.[a-zA-Z]{2,}$/)) {
                mensajesError.push("Ingrese un email válido");
            }
            if (password.length < 6) {
                mensajesError.push("La contraseña debe tener al menos 6 caracteres");
            }
            if (password !== confirmPassword) {
                mensajesError.push("Las contraseñas no coinciden");
            }

            if (mensajesError.length > 0) {
                Swal.fire({
                    title: 'Error',
                    html: mensajesError.join("<br>"),
                    icon: 'error'
                });
                return false;
            }
            realizarSolicitudPost('/api/v1/register', { username, email, password });
            return false;
        }

        function validarLogin() {
            const email = document.getElementById("login-email").value;
            const password = document.getElementById("login-password").value;
            let mensajesError = [];

            if (!email.match(/^[^@]+@[^@]+\.[a-zA-Z]{2,}$/)) {
                mensajesError.push("Ingrese un email válido");
            }
            if (password.length < 6) {
                mensajesError.push("La contraseña debe tener al menos 6 caracteres");
            }

            if (mensajesError.length > 0) {
                Swal.fire({
                    title: 'Error',
                    html: mensajesError.join("<br>"),
                    icon: 'error'
                });
                return false;
            }
            realizarSolicitudPost('/api/v1/login', { email, password });
            return false;
        }
        
        function loginWithProvider(provider) {
            window.location.href = `${window.location.origin}/api/v1/loginoauth/${provider}`;
        }
    </script>
</body>
</html>